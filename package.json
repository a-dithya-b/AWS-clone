{
  "name": "cloudlearn-monorepo",
  "private": true,
  "description": "CloudLearn: a local, open-source simulator for learning AWS hands-on.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -n server,web -c cyan,magenta \"pnpm --filter @cloudlearn/server dev\" \"pnpm --filter @cloudlearn/web dev\"",
    "build": "pnpm --filter @cloudlearn/web build && pnpm --filter @cloudlearn/server build",
    "start": "node apps/server/dist/index.mjs",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.5",
    "concurrently": "^10.0.6",
    "typescript": "^7.0.2"
  }
}
